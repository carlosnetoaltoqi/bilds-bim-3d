# https://editorconfig.org — o mínimo para o repo não misturar tabs, espaços e finais de linha.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{ts,tsx,mts,mjs,js,json,yml,yaml,html,css}]
indent_style = space
indent_size = 2

[*.md]
# espaço duplo no fim da linha é quebra de linha em Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
