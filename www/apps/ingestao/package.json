{
  "name": "ingestao",
  "version": "0.0.1",
  "private": true,
  "description": "Serviço de ingestão: recebe .aq/.zip (biblioteca) ou .stp/.step/.ifc (peça), roda o pipeline Python (pipeline/) e o Chromium (pipeline/thumbs.mjs), grava catálogo e produtos no Mongo e geometria/miniaturas no storage. Futuro deploy próprio consumido pela bilds.com.",
  "scripts": {
    "dev": "node --require ts-node/register --require reflect-metadata src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "@bim/base": "workspace:*",
    "@bim/dominio": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.0.0",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "playwright": "1.62.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/express": "^4.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
