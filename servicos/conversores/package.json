{
  "name": "conversores",
  "version": "0.1.0",
  "private": true,
  "description": "Conversores de peças e formatos: STEP/IGES/IFC → geometria do viewer, geometria → .aq de uma peça, DLL de plugin → catálogo web. Stateless (ADR-013).",
  "scripts": {
    "dev": "node --require ts-node/register --require reflect-metadata src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "@bim/base": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.0.0",
    "multer": "^2.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
