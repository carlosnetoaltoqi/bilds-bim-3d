{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bim_pipeline/contratos/info-familias-revit.schema.json",
  "title": "O que `familias_revit inspecionar` tira de um .rfa, de uma pasta ou de um .zip de famílias Revit",
  "type": "object",
  "required": ["entrada", "bytes", "familias", "n_familias", "n_tipos", "com_geometria_irma", "ignorados", "avisos"],
  "properties": {
    "entrada": { "type": "string" },
    "bytes": { "type": "integer" },
    "n_familias": { "type": "integer" },
    "n_tipos": { "type": "integer" },
    "com_geometria_irma": { "type": "integer" },
    "ignorados": { "type": "integer" },
    "avisos": { "type": "array", "items": { "type": "string" } },
    "familias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["arquivo", "titulo", "tipos", "type_catalog", "preview"],
        "properties": {
          "arquivo": { "type": "string" },
          "titulo": { "type": "string" },
          "revit": { "type": ["string", "null"] },
          "formato": { "type": ["integer", "null"] },
          "categoria": { "type": ["string", "null"] },
          "fabricante": { "type": ["string", "null"] },
          "tipos": { "type": "integer" },
          "type_catalog": { "type": "boolean" },
          "geometria_irma": { "type": ["string", "null"] },
          "preview": { "type": "boolean" }
        }
      }
    }
  }
}
