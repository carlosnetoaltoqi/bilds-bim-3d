input/

# Artefatos de build — o ZIP e a geometria são regeráveis a partir do .aq.
# Os padrões usam ** porque a saída espelha a estrutura de input/
# (output/Amanco/linha/<slug>-<ts>.zip), não fica só na raiz.
output/geo/
output/thumbs/
output/**/*.zip
output/**/*-catalog.json
output/*.json

node_modules/

# Three.js baixado por setup_vendor.sh — nenhuma cópia é versionada.
# Rode scripts/setup_vendor.sh depois de clonar.
templates/vendor/*
!templates/vendor/.gitkeep

# O preview é build: 511 MB em 705 JSONs de geometria nos 10 catálogos, e volta
# inteiro com `build.py --all --force`. Só a landing (index.html) é feita à mão e
# não tem script que a gere — por isso é a única coisa aqui que fica no git.
output/preview/*
!output/preview/.gitignore
!output/preview/.gitkeep
!output/preview/index.html

__pycache__/
*.pyc
*.pyo
.env
.env.*
**/.env
**/.env.*
!**/.env.example
config.json
.vercel

# POC — www/
.next/
www/**/dist/
www/storage/
**/.venv/
*.tsbuildinfo
